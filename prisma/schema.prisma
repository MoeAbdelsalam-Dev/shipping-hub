// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Saved state of the shipment screen for one order, so staff can leave and
// come back (and so an 18-box order isn't retyped). One row per order.
model ShipmentDraft {
  id          String   @id @default(cuid())
  shop        String
  orderId     String // Shopify GID
  orderName   String
  addressType String? // "residential" | "commercial" | null = not decided yet
  boxesJson   String   @default("[]") // Box[] from carriers/types.ts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, orderId])
}

// Cached result of the address classifier, one row per normalized address.
// confirmedType is what staff confirmed last time (the classifier never
// decides on its own).
model AddressCheck {
  id            String    @id @default(cuid())
  shop          String
  addressKey    String
  verdict       String // "residential" | "commercial" | "unsure"
  confidence    Float
  reason        String
  evidenceJson  String    @default("[]") // Evidence[] (max 5)
  source        String // "live" | "mock"
  confirmedType String? // "residential" | "commercial"
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shop, addressKey])
}

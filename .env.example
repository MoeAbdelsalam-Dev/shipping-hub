# Ship Desk environment variables.
# Local dev: copy to .env. Production: set these as Railway service variables.
# Never commit real values. The Setup page shows which are set (names only).

# --- Database ------------------------------------------------------------
DATABASE_URL="file:dev.sqlite"
# Railway (with a volume mounted at /data):
# DATABASE_URL="file:/data/prod.sqlite"

# --- Shopify (filled in by `shopify app dev` locally; set on Railway) ------
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://<your-app>.up.railway.app
# Read-only test build: these three scopes only. No write scopes.
# SCOPES=read_orders,read_customers,read_locations

# --- UPS (UPS Developer Portal → your app's credentials) -----------------
# All three required for UPS to show as connected.
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# UPS_ACCOUNT_NUMBER=
# sandbox (default) or production
# UPS_ENV=sandbox

# --- Canada Post (Canada Post Developer Program → API keys) ---------------
# All four required for Canada Post to show as connected.
# CP_API_USERNAME=
# CP_API_PASSWORD=
# CP_CUSTOMER_NUMBER=
# CP_CONTRACT_NUMBER=
# sandbox (default) or production
# CP_ENV=sandbox

# --- OT -----------------------------------------------------------------
# Only if OT provides an API. Otherwise OT is automated with a Chrome
# extension on the shipping PC (needs approval — see Setup page).
# OT_API_KEY=

# --- Address check (optional) -------------------------------------------
# Both required; without them the address check shows "Not connected".
# BRAVE_SEARCH_API_KEY=
# ANTHROPIC_API_KEY=
# Model for the address check (default claude-opus-5-5)
# CLASSIFIER_MODEL=claude-opus-5-5
# Development only: 1 = use built-in demo search/AI results. Never in production.
# CLASSIFIER_DEMO=
